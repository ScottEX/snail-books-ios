{
  "expo": {
    "name": "狸花猫",
    "slug": "snail-books-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lanx.snailbooks",
      "infoPlist": {
        "NSFaceIDUsageDescription": "用于使用 Face ID 快速登录柳味探秘",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "8.135.58.90": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "snail-books"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "用于将口述内容转成记账草稿的文字",
          "speechRecognitionPermission": "用于识别口述的记账内容，转写后可编辑确认"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withTunnelConfig"
    ]
  }
}
